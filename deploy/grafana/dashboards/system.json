{
  "title": "SCM System",
  "uid": "scm-system",
  "tags": ["scm", "system"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "DB connection pool",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "django_db_new_connections_total",
          "legendFormat": "new connections"
        }
      ]
    },
    {
      "id": 2,
      "title": "DB query latency p95 (s)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(django_db_execute_seconds_bucket[5m])) by (le, alias))",
          "legendFormat": "{{alias}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Celery worker queue length",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 6 },
      "targets": [
        { "expr": "celery_queue_length", "legendFormat": "{{queue_name}}" }
      ]
    },
    {
      "id": 4,
      "title": "Celery task duration p95 by name",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(celery_task_runtime_bucket[5m])) by (le, name))",
          "legendFormat": "{{name}}"
        }
      ]
    }
  ]
}
