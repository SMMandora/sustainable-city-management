{
  "title": "SCM Ingestion Health",
  "uid": "scm-ingest",
  "tags": ["scm", "ingestion"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Records ingested per second by source",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (source) (rate(scm_ingest_records_total{outcome=\"ok\"}[1m]))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Dead-letter rate per source",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (source) (rate(scm_ingest_records_total{outcome=\"deadletter\"}[5m]))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Circuit breaker state (0=closed, 1=open, 2=half-open)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "scm_circuit_breaker_state",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Time since last successful poll (s)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "time() - scm_last_successful_poll_timestamp",
          "legendFormat": "{{source}}"
        }
      ]
    }
  ]
}
